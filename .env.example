# Copy to .env and set POSTGRES_PASSWORD. Nothing here is a secret by default;
# .env itself is gitignored.

POSTGRES_USER=vault
POSTGRES_PASSWORD=
POSTGRES_DB=vault

# Host port for the database. Bound to 127.0.0.1 only.
POSTGRES_PORT=5432

# Used by the CLI and the tests when run outside compose.
DATABASE_URL=postgres://vault:@127.0.0.1:5432/vault
